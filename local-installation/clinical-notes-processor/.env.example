# Copy this file to .env and fill in the values:  cp .env.example .env

# Ollama server, reachable FROM the clinical-api container.
# On a Linux server, use the Docker bridge gateway IP (usually 172.17.0.1 — confirm
# with:  ip -4 addr show docker0).
OLLAMA_HOST=http://172.17.0.1:11434

# Answering model (must be pulled in Ollama:  ollama pull qwen3:8b).
CLINICAL_OLLAMA_MODEL=qwen3:8b

# Folder containing the patient notes (one subfolder per patient), relative to this directory.
CLINICAL_NOTES_HOST_DIR=./notes

# Optional: extra unguarded raw-QA comparison models, served alongside the production
# clinical-notes-model (which stays fully grounded/citation-checked). Each entry adds a
# separate model in Open WebUI's dropdown with none of the production safeguards, useful
# for comparing what the raw LLM says. Format: "served_id:ollama_model,served_id2:model2".
# Pull each model first (e.g. `ollama pull medgemma:4b`).
# CLINICAL_RAW_QA_EXTRA_MODELS=clinical-notes-model-raw-medgemma:medgemma:4b

# Optional: chunk size for the raw-QA comparison model(s) above (defaults shown). Larger
# than the production model's internal chunking on purpose. Only relevant if you're using
# CLINICAL_RAW_QA_EXTRA_MODELS above.
# CLINICAL_RAW_QA_CHUNK_CHARS=8000
# CLINICAL_RAW_QA_CHUNK_OVERLAP_CHARS=500

# Optional: chunk size for the chunked_qa comparison models (clinical-notes-model-chunked /
# -chunked-thinking), always on in Open WebUI's dropdown alongside production and raw_qa.
# These keep production's grounding/citation safeguards but chunk the whole note instead of
# using embedding retrieval (no vector database) -- so a cohort question on these models has
# no fast path and can mean many LLM calls; see the README's "Comparison models" section.
# CLINICAL_CHUNKED_QA_CHUNK_CHARS=16000
# CLINICAL_CHUNKED_QA_CHUNK_OVERLAP_CHARS=500

# Random session secret for the web UI. Generate one with:  openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGEME

# Optional: pin a specific published image version for the running application (otherwise the
# default in docker-compose.yml is used). NOTE: the evaluation (run-evaluation.sh / EVALUATION.md)
# pins its own candidate image and ignores this value, so leave it commented unless you really
# want to change the image your production stack serves.
# CLINICAL_IMAGE=harbor.honeur.org/honeur/clinical-notes-processor:0.6.0
